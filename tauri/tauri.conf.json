{
  "$schema": "https://schema.tauri.app/config/2.0.0-rc",
  "productName": "clt-demo",
  "version": "3.6.2",
  "identifier": "dev.cfmatthee.cltdemo",
  "build": {
    "frontendDist": "../app/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cd ../app && pnpm dev",
    "beforeBuildCommand": "cd ../app && pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "CLT Demo",
        "width": 800,
        "height": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
